---
import { Icon } from "astro-icon/components";

export interface Props {
  icon: string;
  text: string;
  route: string;
  active: boolean;
}

const { icon, text, route, active = true } = Astro.props;

const normalize = (path: string) => path.replace(/\/+$/, "");
const isCurrent = normalize(Astro.url.pathname) === normalize(route);
---

<a
  class:list={[
    "flex items-center gap-2 rounded-lg px-2 py-2 transition-colors",
    isCurrent ? "bg-white text-sky-700 shadow-sm" : "hover:bg-white/70",
    !active && "opacity-40",
  ]}
  href={route}
  aria-current={isCurrent ? "page" : undefined}
>
  <Icon name={icon} class="inline-block w-8 shrink-0 text-3xl" />
  <span class="text-lg font-bold">{text}</span>
</a>
