---
/**
 * Sticky top bar (visible below lg).
 *
 * Props:
 *   navFlyoutId    – flyout id for the left hamburger toggle
 *   rightFlyoutId  – flyout id for the optional right action button
 *   rightIcon      – mdi icon name for the right button (e.g. "mdi:chart-bar")
 *   rightLabel     – accessible name of the panel opened by the right button
 */
import { Icon } from "astro-icon/components";

interface Props {
  navFlyoutId: string;
  rightFlyoutId?: string;
  rightIcon?: string;
  rightLabel?: string;
}

const { navFlyoutId, rightFlyoutId, rightIcon, rightLabel } = Astro.props;

const buttonClass =
  "flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-slate-700 transition-colors hover:bg-white/60";
---

<div
  class="sticky top-4 z-30 m-4 flex items-center justify-between rounded-2xl bg-sky-100/90 px-4 py-3 shadow-md backdrop-blur-sm lg:hidden"
>
  <button
    type="button"
    data-flyout-toggle={navFlyoutId}
    aria-label="Open navigation"
    aria-expanded="false"
    class={buttonClass}
  >
    <Icon name="mdi:menu" class="text-3xl" />
  </button>

  <span class="text-2xl font-bold">
    T<span class="text-sky-500">W</span>ONy
    <span class="text-sm font-normal text-slate-500">(micro)</span>
  </span>

  {
    rightFlyoutId && rightIcon ? (
      <button
        type="button"
        data-flyout-toggle={rightFlyoutId}
        aria-label={`Open ${(rightLabel ?? "panel").toLowerCase()}`}
        aria-expanded="false"
        class={buttonClass}
      >
        <Icon name={rightIcon} class="text-3xl" />
      </button>
    ) : (
      <div class="h-10 w-10" />
    )
  }
</div>
