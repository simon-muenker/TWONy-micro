---
/**
 * Responsive side panel.
 *
 * Below the `staticFrom` breakpoint the panel is an off-canvas flyout that
 * slides in from `side`. From that breakpoint on it is a regular, sticky
 * column of the page grid. The content is rendered (and hydrated) only once
 * for both presentations.
 *
 * Opening/closing is wired by the script in BaseLayout via data attributes:
 *   data-flyout="<id>"         – on the panel
 *   data-flyout-toggle="<id>"  – on buttons that open the panel
 *   data-flyout-close          – on the close button inside the panel
 *   data-open                  – set on the panel while it is open
 *
 * Props:
 *   id         – unique id referenced by toggle buttons
 *   side       – "left" | "right", slide-in direction
 *   staticFrom – "lg" | "xl", breakpoint from which the panel is a grid column
 *   label      – accessible name of the panel
 *
 * Slots:
 *   header  – shown left of the close button; stays visible in column mode.
 *             Without it the whole header row is hidden in column mode.
 *   default – panel content
 */
import { Icon } from "astro-icon/components";

interface Props {
  id: string;
  side: "left" | "right";
  staticFrom: "lg" | "xl";
  label: string;
}

const { id, side, staticFrom, label } = Astro.props;

// Complete class names are spelled out so Tailwind can detect them.
const sideClass = {
  left: "left-0 -translate-x-full",
  right: "right-0 translate-x-full",
}[side];

const staticClass = {
  lg: "lg:visible lg:sticky lg:inset-auto lg:top-4 lg:z-auto lg:col-span-4 lg:max-h-[calc(100dvh-2rem)] lg:w-auto lg:max-w-none lg:translate-x-0 lg:self-start lg:bg-transparent lg:p-0 lg:shadow-none lg:transition-none xl:col-span-3",
  xl: "xl:visible xl:sticky xl:inset-auto xl:top-4 xl:z-auto xl:col-span-3 xl:max-h-[calc(100dvh-2rem)] xl:w-auto xl:max-w-none xl:translate-x-0 xl:self-start xl:bg-transparent xl:p-0 xl:shadow-none xl:transition-none",
}[staticFrom];

const staticHidden = { lg: "lg:hidden", xl: "xl:hidden" }[staticFrom];
const staticQuery = { lg: "(min-width: 64rem)", xl: "(min-width: 80rem)" }[
  staticFrom
];

const hasHeader = Astro.slots.has("header");
---

<aside
  data-flyout={id}
  data-flyout-static={staticQuery}
  aria-label={label}
  class:list={[
    "invisible fixed inset-y-0 z-50 w-96 max-w-[90vw] overflow-y-auto overscroll-contain bg-white p-5 shadow-xl",
    "transition-[translate,visibility] duration-300 ease-in-out",
    "data-open:visible data-open:translate-x-0",
    sideClass,
    staticClass,
  ]}
>
  <div class="flex min-h-full flex-col gap-8">
    <div
      class:list={[
        "flex items-start justify-between gap-4",
        !hasHeader && staticHidden,
      ]}
    >
      {
        hasHeader ? (
          <slot name="header" />
        ) : (
          <span class="mt-2 text-base font-semibold text-slate-700">
            {label}
          </span>
        )
      }
      <button
        type="button"
        data-flyout-close
        aria-label={`Close ${label.toLowerCase()}`}
        class:list={[
          "flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg text-slate-600 transition-colors hover:bg-slate-100",
          staticHidden,
        ]}
      >
        <Icon name="mdi:close" class="text-3xl" />
      </button>
    </div>
    <slot />
  </div>
</aside>
